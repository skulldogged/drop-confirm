{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "${mod_sources}",
    "issues": "${mod_issue_tracker}"
  },
  "environment": "client",
  "icon": "drop_confirm.png",
  "entrypoints": {
    "main": [
      "dev.skulldogged.drop_confirm.loaders.fabric.FabricEntrypoint"
    ],
    "modmenu": [
      "dev.skulldogged.drop_confirm.loaders.fabric.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "${fabric_key_api}": "*",
    "${fabric_resource_api}": "*",
    "fabric-language-kotlin": "${fabric_kotlin_range}"
  }
}
